 static ExplainOneQuery_hook_type prev_explain_one_query_hook = NULL;
 static emit_log_hook_type prev_emit_log_hook = NULL;
+static int postgres_planner_nest_level = 0;
+
+namespace pgduckdb {
+PlannedStmt *
+PlanPostgresQuery(Query *parse, const char *query_string, int cursor_options, ParamListInfo bound_params) {
+	PlannedStmt *stmt = nullptr;
+
+	/*
+	 * Enter the complete planner hook chain so hooks such as TimescaleDB can
+	 * initialize their per-query state. DuckdbPlannerHook_Cpp observes this
+	 * guard and forwards instead of recursively forcing DuckDB execution.
+	 */
+	postgres_planner_nest_level++;
+	PG_TRY();
+	{
+		stmt = planner_hook ? planner_hook(parse, query_string, cursor_options, bound_params)
+		                    : standard_planner(parse, query_string, cursor_options, bound_params);
+	}
+	PG_FINALLY();
+	{
+		postgres_planner_nest_level--;
+	}
+	PG_END_TRY();
+
+	return stmt;
+}
